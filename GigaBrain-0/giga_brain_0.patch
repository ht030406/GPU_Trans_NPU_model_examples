+# Ascend NPU / aarch64 workaround: torch's intra-op thread pool deadlocks in
+# forked DataLoader workers (post-fork parallel_for hang). Force single-threaded
+# torch ops so forked children never contend on the inherited pool. This must run
+# before any DataLoader is created (accelerate overrides OMP_NUM_THREADS with
+# --num_cpu_threads_per_process, so env vars alone are insufficient).
+os.environ['OMP_NUM_THREADS'] = '1'
+os.environ['MKL_NUM_THREADS'] = '1'
+torch.set_num_threads(1)
